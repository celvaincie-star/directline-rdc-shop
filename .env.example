# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).

# --- WhatsApp Cloud API (Meta) : voir docs/ETAPE2_WHATSAPP.md ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
# Mot de passe de votre choix, à recopier à l'identique dans la page Webhook de Meta
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# Votre WhatsApp perso (format international sans + ni espaces), pour les transferts à un humain
OWNER_WHATSAPP=243XXXXXXXXX

# Anti-spam : 15 messages max par numéro toutes les 10 minutes
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_SECONDS=600
